# Doxygen configuration for Myriad project documentation.

PROJECT_NAME = "$(MYRIAD_DOXYGEN_PROJECT_NAME)"
PROJECT_BRIEF = "$(MYRIAD_DOXYGEN_PROJECT_BRIEF)"
OUTPUT_DIRECTORY = $(MYRIAD_DOXYGEN_OUTPUT_DIRECTORY)
CREATE_SUBDIRS = NO
OUTPUT_LANGUAGE = English

GENERATE_HTML = YES
GENERATE_LATEX = NO
GENERATE_XML = NO

INPUT = README.md $(MYRIAD_DOXYGEN_INPUT)
RECURSIVE = YES

USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
HIDE_UNDOC_MEMBERS = YES
HIDE_UNDOC_CLASSES = NO

OPTIMIZE_OUTPUT_FOR_C = NO
OPTIMIZE_OUTPUT_JAVA = NO

JAVADOC_AUTOBRIEF = YES
MULTILINE_CPP_IS_BRIEF = YES
QT_AUTOBRIEF = NO

WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
QUIET = NO

FULL_PATH_NAMES = NO
STRIP_FROM_PATH = /workspaces/Myriad

SOURCE_BROWSER = YES
INLINE_SOURCES = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION = YES

GENERATE_TREEVIEW = YES
DISABLE_INDEX = NO
