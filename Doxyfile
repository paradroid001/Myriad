# Doxygen configuration for Myriad editor codebase documentation.

PROJECT_NAME = "Myriad Editor"
PROJECT_BRIEF = "API documentation for the Myriad editor module"
OUTPUT_DIRECTORY = docs/doxygen
CREATE_SUBDIRS = NO
OUTPUT_LANGUAGE = English

GENERATE_HTML = YES
GENERATE_LATEX = NO
GENERATE_XML = NO

INPUT = Editor/src
FILE_PATTERNS = _.h _.hpp _.cpp
RECURSIVE = YES
EXCLUDE_PATTERNS = _/vendor/\*

USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
HIDE_UNDOC_MEMBERS = YES
HIDE_UNDOC_CLASSES = NO

OPTIMIZE_OUTPUT_FOR_C = NO
OPTIMIZE_OUTPUT_JAVA = NO

JAVADOC_AUTOBRIEF = YES
MULTILINE_CPP_IS_BRIEF = YES
QT_AUTOBRIEF = NO

WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
QUIET = NO

FULL_PATH_NAMES = NO
STRIP_FROM_PATH = /workspaces/Myriad

SOURCE_BROWSER = YES
INLINE_SOURCES = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION = YES

GENERATE_TREEVIEW = YES
DISABLE_INDEX = NO
