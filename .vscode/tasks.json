{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake (default Linux)",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build/Linux"
      },
      "command": "cmake",
      "args": [
        "-D",
        "CMAKE_TOOLCHAIN_FILE=TC-linux.cmake",
        "\"MinGW Makefiles\"",
        "${workspaceFolder}"
      ],
      "group": "build"
    },
    {
      "label": "cmake (Windows)",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build/Windows"
      },
      "command": "cmake",
      "args": [
        "-D",
        "CMAKE_TOOLCHAIN_FILE=TC-windows.cmake",
        "\"MinGW Makefiles\"",
        "${workspaceFolder}"
      ],
      "group": "build"
    },
    {
      "label": "Build Myriad",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "command": "make",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Build Myriad (General Purpose)"
    },
    {
      "label": "Build Myriad (Linux)",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "command": "make",
      "group": "build",
      "detail": "Build for Linux"
    },
    {
      "label": "Build Myriad (Windows)",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "command": "make",
      "group": "build",
      "detail": "Build for Windows"
    },
    {
      "type": "cmake",
      "label": "CMake: clean rebuild",
      "command": "cleanRebuild",
      "targets": ["all"],
      "group": "build",
      "problemMatcher": [],
      "detail": "CMake template clean rebuild task"
    },
    {
      "type": "cmake",
      "label": "CMake: build",
      "command": "build",
      "targets": ["all"],
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "detail": "CMake template build task"
    }
  ]
}
