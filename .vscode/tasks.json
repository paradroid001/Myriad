{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "command": "cmake \"MinGW Makefiles\" ${workspaceFolder}",
            "group": "build"
        },
        {
            "label": "Build Myriad",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "command": "make",
            "group": "build"
        },
    ]
}