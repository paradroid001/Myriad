{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake (default Linux)",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "command": "cmake \"MinGW Makefiles\" ${workspaceFolder}",
      "group": "build"
    },
    {
      "label": "cmake (Windows)",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "command": "cmake -D CMAKE_TOOLCHAIN_FILE=TC-windows.cmake \"MinGW Makefiles\" ${workspaceFolder}",
      "group": "build"
    },
    {
      "label": "Build Myriad",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/build"
      },
      "command": "make",
      "group": "build"
    },
    {
      "type": "cmake",
      "label": "CMake: clean rebuild",
      "command": "cleanRebuild",
      "targets": ["all"],
      "group": "build",
      "problemMatcher": [],
      "detail": "CMake template clean rebuild task"
    }
  ]
}
