[submodule "raylib"]
	path = shared/vendor/raylib
	url = https://github.com/raysan5/raylib
    branch = 5.5
[submodule "json"]
	path = shared/vendor/json
	url = https://github.com/nlohmann/json
	branch = master
[submodule "catch2"]
	path = shared/vendor/catch2
	url = https://github.com/catchorg/Catch2.git
[submodule "cereal"]
	path = shared/vendor/cereal
	url = https://github.com/USCiLab/cereal.git
[submodule "imgui"]
	path = shared/vendor/imgui
	url = https://github.com/ocornut/imgui.git
    branch = docking
[submodule "rlImGui"]
	path = shared/vendor/rlImGui
	url = https://github.com/raylib-extras/rlImGui
[submodule "nbnet"]
	path = shared/vendor/nbnet
	url = https://github.com/nathhB/nbnet.git
